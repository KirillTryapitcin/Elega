{
  "name": "@elega/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "messages"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*.json": "./messages/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@elega/config": "workspace:*",
    "@types/node": "22.20.5",
    "intl-messageformat": "12.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
