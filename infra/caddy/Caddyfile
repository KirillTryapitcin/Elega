# Local reverse proxy: one origin for the web app and the API, like production.
{
	admin off
	auto_https off
}

:80 {
	request_header X-Request-Id {http.request.uuid}
	header -Server

	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:3001
	}

	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
