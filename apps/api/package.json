{
  "name": "@elega/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.js)",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "seed": "node --env-file-if-exists=../../.env dist/cli/seed.js",
    "invites:create": "node --env-file-if-exists=../../.env dist/cli/invites.js"
  },
  "dependencies": {
    "@elega/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "argon2": "0.45.1",
    "disposable-email-domains-js": "1.26.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@elega/api-client": "workspace:*",
    "@elega/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "13.1.3",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
