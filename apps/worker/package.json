{
  "name": "@elega/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.js)",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@elega/i18n": "workspace:*",
    "@elega/shared": "workspace:*",
    "@prometheus-io/client": "0.16.1",
    "blurhash": "2.0.5",
    "bullmq": "6.3.11",
    "file-type": "22.1.1",
    "intl-messageformat": "12.1.2",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@elega/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
