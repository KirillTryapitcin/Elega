# Local development only. Every credential below contains "local_only"; the API and worker
# refuse to start with APP_ENV=production or staging if any variable still contains that marker.
# Copy to .env for `pnpm dev`; `docker compose up` works without a .env file.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug

# API (apps/api)
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://elega:elega_local_only@localhost:5432/elega
REDIS_URL=redis://:elega_local_only@localhost:6379
TRUST_PROXY_HOPS=0
# Web app origin (links in emails, Origin checks, OAuth redirect URIs).
APP_BASE_URL=http://localhost:3000
# Root secret; JWT, TOTP and hashing keys are derived from it. Production: openssl rand -base64 48
APP_SECRET=elega_local_only_app_secret_0123456789abcdef
# Optional key rotation lists (id:secret, newest first). Default: derived from APP_SECRET.
# AUTH_JWT_KEYS=
# AUTH_TOTP_KEYS=
REGISTRATION_MODE=invite_only
# VK ID / Yandex ID / Google apps (see docs/auth-providers.md). Unset = button hidden.
# VK_CLIENT_ID=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Worker (apps/worker)
HEALTH_PORT=3002

# Object storage (SeaweedFS S3 locally; used from M2)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=elega_local_only
S3_SECRET_KEY=elega_local_only_secret
S3_BUCKET_PRIVATE=elega-private
S3_BUCKET_PUBLIC=elega-public

# Mail (Mailpit locally; used from M1). Web UI: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Элега <no-reply@elega.local>

# Web dev server: where `pnpm dev` forwards /api/v1 (Caddy does this in Compose).
DEV_API_URL=http://localhost:3001

# Disable vendor telemetry in local tooling.
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
