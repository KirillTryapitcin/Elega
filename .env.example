# Local development only. Every credential below contains "local_only"; the API and worker
# refuse to start with APP_ENV=production or staging if any variable still contains that marker.
# Copy to .env for `pnpm dev`; `docker compose up` works without a .env file.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug

# API (apps/api)
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://elega:elega_local_only@localhost:5432/elega
REDIS_URL=redis://:elega_local_only@localhost:6379
TRUST_PROXY_HOPS=0
# Web app origin (links in emails, Origin checks, OAuth redirect URIs).
APP_BASE_URL=http://localhost:3000
# Root secret; JWT, TOTP and hashing keys are derived from it. Production: openssl rand -base64 48
APP_SECRET=elega_local_only_app_secret_0123456789abcdef
# Optional key rotation lists (id:secret, newest first). Default: derived from APP_SECRET.
# AUTH_JWT_KEYS=
# AUTH_TOTP_KEYS=
REGISTRATION_MODE=invite_only
# Version of the consent to dissemination of personal data (152-FZ Art. 10.1) shown when a
# profile is made public. Bumping it invalidates earlier consents until users accept again.
LEGAL_PD_DISSEMINATION_VERSION=2026-10-01
# VK ID / Yandex ID / Google apps (see docs/auth-providers.md). Unset = button hidden.
# VK_CLIENT_ID=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Worker (apps/worker)
# Roles this process runs: core (outbox relay, email, heartbeat) and media (image processing,
# cleanup). `pnpm dev` runs both in one process; compose runs worker (core) and worker-media.
WORKER_ROLES=core,media
# Health server; /metrics is served there too unless METRICS_ENABLED=false.
HEALTH_PORT=3002
METRICS_ENABLED=true
# Media jobs processed in parallel by one worker (each decodes one image).
MEDIA_CONCURRENCY=2
# Upload antivirus: off (local and test only; staging and production refuse it) or clamd.
# To scan locally: `docker compose --profile av up -d clamav` (about 1 GB of RAM, the first
# start downloads signatures), then set ANTIVIRUS_MODE=clamd and CLAMAV_HOST=localhost.
ANTIVIRUS_MODE=off
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# Upper bound for one scan; a timeout fails the job and it is retried.
# CLAMAV_TIMEOUT_MS=30000

# Object storage (SeaweedFS S3 locally). Read by the API and the media worker.
# Endpoint the API and the worker call.
S3_ENDPOINT=http://localhost:8333
# Endpoint the browser reaches: presigned uploads and signed media URLs are signed for this host,
# and the web CSP allows it (path-scoped to the private bucket). Production requires https.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Every M2 object lives in the private bucket and is served by short-lived signed URLs.
S3_BUCKET_PRIVATE=elega-private
# Reserved for public-audience media behind a CDN (M12); unused in M2 but validated.
S3_BUCKET_PUBLIC=elega-public
# Storage identities (infra/seaweedfs/s3.json): elega-api may read and write objects in the
# private bucket; elega-worker may also list them. Compose gives each service its own identity.
# `pnpm dev` reads this one file for the API and the worker, so it uses the worker identity;
# the API integration tests run with the API identity.
S3_ACCESS_KEY=elega_local_only_worker
S3_SECRET_KEY=elega_local_only_worker_secret

# Mail (Mailpit locally; used from M1). Web UI: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Элега <no-reply@elega.local>

# Web dev server: where `pnpm dev` forwards /api/v1 (Caddy does this in Compose).
DEV_API_URL=http://localhost:3001
# Web server-side fetches (profile pages) call the API here; compose uses http://api:3001.
# Unset in development: falls back to DEV_API_URL. The web also reads APP_BASE_URL,
# S3_PUBLIC_ENDPOINT and S3_BUCKET_PRIVATE from above.
# API_INTERNAL_URL=http://localhost:3001

# Disable vendor telemetry in local tooling.
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
